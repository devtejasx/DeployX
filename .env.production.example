# Production settings for DeployX: a template, never a real file.
#
# Development uses .env (from .env.example); the tests use their own database
# (<db>_test) and queue prefix (deployx-test). Production gets its values from
# a secret store (AWS Secrets Manager / SSM Parameter Store into the ECS task
# definition, or your orchestrator's secrets), not from a file in an image.
# Every <...> below must be replaced; the API refuses to start in production
# with development passwords, insecure cookies or a "*" / non-HTTPS CLIENT_URL.

# ---- Both API and worker ----
NODE_ENV=production
DATABASE_URL=postgresql://deployx:<strong-password>@<db-host>:5432/deployx?sslmode=require
REDIS_URL=rediss://:<strong-password>@<redis-host>:6380
QUEUE_PREFIX=deployx
LOG_LEVEL=info
LOG_FORMAT=json
# Bearer token Prometheus sends to /metrics (API and worker).
METRICS_TOKEN=<random, e.g. 48 hex characters>

# ---- API ----
PORT=5000
# The public HTTPS origin of the dashboard (comma-separate several).
CLIENT_URL=https://<deployx.example.com>
# Proxies in front of the API (the load balancer, and nginx if used).
TRUST_PROXY=1
ALLOW_REGISTRATION=false
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=60
PASSWORD_HASH_COST=17
GITHUB_WEBHOOK_SECRET=<random, at least 20 characters>
API_SHUTDOWN_TIMEOUT_MS=10000

# ---- Worker ----
WORKER_CONCURRENCY=2
WORKER_METRICS_PORT=9464
WORKER_METRICS_HOST=0.0.0.0
DEPLOYMENT_TIMEOUT_MS=1800000
HEALTH_CHECK_ALLOW_PRIVATE_URLS=false
# Private repositories (optional): the GitHub App's ID and PEM key.
GITHUB_APP_ID=<app id>
GITHUB_APP_PRIVATE_KEY=<from the secret store>
# AWS: names only. Credentials come from the worker's IAM role; do not set
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
AWS_REGION=<region>
AWS_ECR_REPOSITORY=<repository>
AWS_ECS_CLUSTER=<cluster>
