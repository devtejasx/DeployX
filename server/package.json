{
  "name": "deployx-server",
  "version": "0.1.0",
  "private": true,
  "description": "DeployX API server",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js up",
    "migrate:down": "node src/db/migrate.js down",
    "migrate:create": "node-pg-migrate create -m src/db/migrations --migration-file-language sql"
  },
  "engines": {
    "node": ">=20.12"
  },
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "redis": "^5.12.1",
    "zod": "^4.6.5"
  }
}
