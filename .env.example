# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# The real .env is git-ignored. Never commit secrets.

# ---- API server ----
NODE_ENV=development
PORT=5000

# Origin(s) of the dashboard, comma-separated. Only these get CORS headers and
# may send state-changing requests from a browser. Never "*". HTTPS in production.
CLIENT_URL=http://localhost:3000
# Behind a load balancer or reverse proxy: the number of proxy hops (e.g. 1),
# so client addresses (rate limits, audit log) are read correctly.
# TRUST_PROXY=

# Connection strings used when the API runs on your machine (npm run dev:server).
# Inside Docker Compose these are overridden to point at the postgres/redis containers.
DATABASE_URL=postgresql://deployx:deployx@localhost:5432/deployx
REDIS_URL=redis://:deployx-dev-redis@localhost:6379

# ---- Sign-in (API) ----
# Accounts sign in with an email and password (scrypt-hashed) and get a
# server-side session in an HttpOnly cookie. The first account registered while
# no ADMIN exists becomes ADMIN. Self-service registration is on by default
# except in production; there, create accounts with:
#   printf '%s
' "$PASSWORD" | npm --prefix server run user:create -- --email you@example.com --role ADMIN
# ALLOW_REGISTRATION=
# Session lifetime, and how long a session survives without a request.
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=60
# Secure (HTTPS-only) cookie. Defaults to true when NODE_ENV=production.
# SESSION_COOKIE_SECURE=
# log2 of scrypt's N: 17 = 128 MiB per hash (OWASP). Lower only for tests.
# PASSWORD_HASH_COST=17

# ---- Logs, metrics and shutdown (API and worker) ----
# Structured JSON lines on stdout; secrets are redacted.
LOG_LEVEL=info
# json (default, for log pipelines) or pretty (one readable line per entry).
LOG_FORMAT=json
# Prometheus scrapes GET /metrics with "Authorization: Bearer <METRICS_TOKEN>".
# Without a token, /metrics is open in development and disabled in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
METRICS_TOKEN=
# How long the API waits for running requests on SIGTERM.
API_SHUTDOWN_TIMEOUT_MS=10000

# ---- Alert thresholds (dashboard monitoring panel; mirrored in monitoring/alert-rules.yml) ----
ALERT_QUEUE_BACKLOG=10
ALERT_FAILURE_RATE=0.5
ALERT_FAILURE_RATE_MIN_DEPLOYMENTS=5
ALERT_REPEATED_ROLLBACKS=3
ALERT_HEALTH_CHECK_FAILURES=3
ALERT_AWS_FAILURES=3
ALERT_STUCK_AFTER_MINUTES=15

# ---- Rate limits (API) ----
# Requests per window, counted in Redis (in memory while Redis is down).
# 429 + Retry-After when exceeded. See README, Phase 8.
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_15_MINUTES=10
RATE_LIMIT_LOGIN_PER_EMAIL=5
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_WEBHOOKS_PER_MINUTE=120
RATE_LIMIT_DEPLOYMENTS_PER_MINUTE=20
RATE_LIMIT_PROJECTS_PER_HOUR=30

# ---- GitHub push webhooks (API) ----
# Secret shared with GitHub: every delivery to POST /api/webhooks/github must
# be signed with it (X-Hub-Signature-256), or it is refused. Webhooks are
# disabled (503) while it is empty. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_WEBHOOK_SECRET=

# ---- Deployment job queue (BullMQ on Redis) ----
# Redis key prefix; the API and the worker must use the same value.
QUEUE_PREFIX=deployx
# Tries per deployment job (first run included) and the exponential backoff
# base between them: 2s, then 4s, ...
DEPLOYMENT_JOB_ATTEMPTS=3
DEPLOYMENT_JOB_BACKOFF_MS=2000

# ---- Live log streams (SSE) ----
# How often each open stream re-checks the database (safety net when a Redis
# event is missed or Redis is down), and the keep-alive interval.
LOG_STREAM_POLL_MS=2000
LOG_STREAM_HEARTBEAT_MS=15000

# ---- Worker ----
WORKER_CONCURRENCY=2
# Heartbeat written to Redis (read by the API for worker status and alerts).
HEARTBEAT_INTERVAL_MS=10000
# The worker's /health, /ready and /metrics. "off" disables it. Bound to
# 127.0.0.1 by default; Docker Compose uses 0.0.0.0 inside the container
# without publishing the port.
WORKER_METRICS_PORT=9464
WORKER_METRICS_HOST=127.0.0.1
# How long shutdown waits for running jobs before forcing it.
WORKER_SHUTDOWN_TIMEOUT_MS=25000
# Upper bound for one deployment attempt, whatever it is doing (each step also
# has its own limit). Over it: the running step is stopped, the deployment
# FAILED without a retry, and cleanup / rollback still run.
DEPLOYMENT_TIMEOUT_MS=1800000
# Deployments unfinished for STUCK_DEPLOYMENT_AFTER_MS whose job is no longer
# in the queue are marked FAILED (checked every RECOVERY_INTERVAL_MS).
RECOVERY_INTERVAL_MS=60000
STUCK_DEPLOYMENT_AFTER_MS=600000
# No PostgreSQL statement may run longer than this (API default 15000).
DATABASE_STATEMENT_TIMEOUT_MS=30000

# ---- Docker deployments (worker) ----
# Network deployed apps run on; separate from DeployX's own services.
DEPLOYX_APP_NETWORK=deployx-apps
# Limits for builds and for each deployed app container.
DOCKER_BUILD_TIMEOUT_MS=600000
APP_MEMORY_LIMIT=512m
APP_CPU_LIMIT=1
# A new container must still be running after this long to count as started.
CONTAINER_STARTUP_GRACE_MS=3000

# ---- Health checks of deployed apps (worker) ----
# After a container starts, the worker requests GET <project health_check_path>
# (default /health) on the container's published port. A deployment only
# becomes SUCCESS after a 2xx answer; otherwise it fails and is rolled back.
# Host the published ports are reachable on: 127.0.0.1 when the worker runs on
# this machine. Docker Compose sets host.docker.internal for its worker.
HEALTH_CHECK_HOST=127.0.0.1
# Time one request may take.
HEALTH_CHECK_TIMEOUT_MS=2000
# Pause between two attempts.
HEALTH_CHECK_INTERVAL_MS=2000
# Attempts before the deployment counts as unhealthy.
HEALTH_CHECK_RETRIES=5
# Time the application gets to start before the first attempt.
HEALTH_CHECK_STARTUP_GRACE_MS=5000
# AWS_ECS projects are checked on their service URL, which must resolve to a
# public address. true also allows private ones (an internal load balancer,
# the worker in the same VPC). Link-local/metadata addresses are always refused.
HEALTH_CHECK_ALLOW_PRIVATE_URLS=false

# ---- Private GitHub repositories (worker, optional) ----
# A GitHub App installed on the repositories DeployX deploys. The worker
# exchanges it for a read-only token per deployment (never stored or logged).
# Without it, only public repositories can be cloned.
# The private key is the App's .pem file; write it on one line with \n for
# the line breaks, or pass it from a secret store.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# ---- AWS deployments (worker, for projects with deployment_target AWS_ECS) ----
# Images are pushed to one ECR repository and deployed to each project's ECS
# service in one cluster; the repository, cluster and services are created
# beforehand (see README, Phase 7). No credentials here: the AWS SDK reads
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN or AWS_PROFILE
# from the environment, or uses the IAM role of the machine or task.
AWS_REGION=
AWS_ECR_REPOSITORY=
AWS_ECS_CLUSTER=
# How long an ECS rollout may take, and how often its progress is checked.
AWS_ECS_DEPLOY_TIMEOUT_MS=600000
AWS_ECS_POLL_INTERVAL_MS=10000
# Every AWS API call: time to connect, and to receive the response.
AWS_CONNECTION_TIMEOUT_MS=5000
AWS_REQUEST_TIMEOUT_MS=30000

# Group that owns /var/run/docker.sock (Docker Compose only). 0 on Docker
# Desktop; on Linux use: stat -c %g /var/run/docker.sock
DOCKER_SOCKET_GID=0
# Where the worker clones repositories (default: <os temp dir>/deployx-workspaces).
# WORKSPACE_ROOT=

# ---- PostgreSQL and Redis containers (docker-compose.yml) ----
# Development defaults. Change both passwords (and the URLs above) for any
# environment other than your own machine.
POSTGRES_USER=deployx
POSTGRES_PASSWORD=deployx
POSTGRES_DB=deployx
REDIS_PASSWORD=deployx-dev-redis

# ---- Host ports published by Docker Compose ----
POSTGRES_PORT=5432
REDIS_PORT=6379
